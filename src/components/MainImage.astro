---
import { Picture } from "astro:assets";

type Props = {
  image: ImageMetadata;
  alt: string;
};

function getFormats(): string[] {
  if (import.meta.env.DEV) return ["webp"];
  if (import.meta.env.PROD) return ["jxl", "avif", "webp"];
  return [];
}

const formats = getFormats();


const { image, alt } = Astro.props;
const widthSet: Record<number, number> = {
    1536: 2048,
    1024: 1536,
    768: 640,
}

// Cap at 3840 (largest entry below) so JXL encoding stays tractable; the
// source image can be 7K+ but we never need to ship that.
const widths = [400, 640, 800, 1024, 1280, 1440, 1920, 2560, 2880, 3840]
    .filter((w) => w <= image.width);

const sizesString = Object.entries(widthSet)
    .toSorted((a, b) => Number(a) - Number(b))
    .map(([width, size]) => `(max-width: ${width}px) ${size}px`)
    .join(", ");

---

<style>
  div.main-image {
    display: flex;
    justify-content: center;
    align-items: center;
  }
</style>

<div class="main-image">
  <Picture
    src={image}
    alt={alt}
    formats={formats}
    fallbackFormat="jpg"
    quality={"high"}
    loading={"eager"}
    widths={widths}
    sizes={sizesString}
  />
</div>
