---
import '@fontsource/gowun-batang'

export interface Props {
  hangul: string;
  roman: string;
}
const { hangul, roman } = Astro.props;
const longest = hangul.length > roman.length ? hangul : roman;
---
<span
  class="fading-text"
  data-longest={longest}
  tabindex="0"
  role="button"
  aria-label={`Show Hangul: ${hangul}`}
>
  <span class="text romanized">{roman}</span>
  <span class="text hangul">{hangul}</span>
</span>

<style>
  .fading-text {
    display: inline-block;
    position: relative;
    vertical-align: baseline;
    cursor: help;
  }

  .text {
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.5s ease;
    white-space: nowrap;
  }

  .romanized {
    opacity: 1;
  }

  .hangul {
    opacity: 0;
    font-family: 'Gowun Batang', serif;
  }

  .fading-text:hover .romanized,
  .fading-text:focus-visible .romanized,
  .fading-text.show-hangul .romanized {
    opacity: 0;
  }

  .fading-text:hover .hangul,
  .fading-text:focus-visible .hangul,
  .fading-text.show-hangul .hangul {
    opacity: 1;
  }

  /* Ensure the container is wide enough for the larger text */
  .fading-text::before {
    content: attr(data-longest);
    visibility: hidden;
    display: block;
    height: 0;
  }
</style>

<script>
  // Tap-to-toggle on devices without hover (mobile). Delegated so we only
  // bind once even with many <HoverForHangul> on the page.
  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    const el = target?.closest?.(".fading-text");
    if (el instanceof HTMLElement) el.classList.toggle("show-hangul");
  });
</script>
