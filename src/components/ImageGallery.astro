---
import ImageView from "./ImageView.astro";
export interface Props {
  images: {
    image: ImageMetadata;
    alt: string;
  }[];
}

const { images } = Astro.props;
const uniqueId = crypto.randomUUID();
---

<style>
  @reference "../styles/global.css";
    .my-carousel:not(:fullscreen) {
      @apply carousel carousel-center;
    }

    .my-carousel:not(:fullscreen) div.item {
      @apply carousel-item w-full;
    }

  .my-carousel {
    margin-bottom: 1rem;
  }

  .my-carousel div.item div.absolute {
    top: 50%;
  }

  .my-carousel:hover div.item div.absolute {
    opacity: 1;
  }

</style>

<div class="my-carousel" data-carousel-id={uniqueId}>
  {
    images.map(({ image, alt }, idx) => (
      <div class="item relative" id={`${uniqueId}-slide-${idx}`}>
        <ImageView image={image} alt={alt} />
        <div
         class="absolute left-5 right-5 flex -translate-y-1/2 transition-opacity transform justify-between z-10 opacity-0"
         data-top={image.height}
        >
          <a
            href={`#${uniqueId}-slide-${idx - 1 < 0 ? images.length - idx - 1 : idx - 1}`}
            class="btn btn-circle"
          >
            ❮
          </a>
          <a
            href={`#${uniqueId}-slide-${(idx + 1) % images.length}`}
            class="btn btn-circle"
          >
            ❯
          </a>
        </div>
      </div>
    ))
  }
</div>

<script>
  // Intercept carousel arrow clicks: scroll the target slide into view inside
  // its (horizontal-snap) parent, without pushing a history entry per click.
  // The href attribute is kept so the carousel still navigates without JS.
  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    const link = target?.closest?.(".my-carousel a[href^='#']");
    if (!(link instanceof HTMLAnchorElement)) return;
    const id = link.getAttribute("href")?.slice(1);
    if (!id) return;
    const slide = document.getElementById(id);
    if (!slide) return;
    event.preventDefault();
    slide.scrollIntoView({ behavior: "smooth", block: "nearest", inline: "start" });
  });
</script>
