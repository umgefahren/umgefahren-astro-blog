---
import { ExifTool, type Tags } from "exiftool-vendored";
import { Picture } from "astro:assets";
import ShutterSpeed from "./ShutterSpeed.svelte";

export interface Props {
  image: ImageMetadata;
  alt: string;
  height?: number;
  width?: number;
}

const { image, alt, height, width } = Astro.props;

const elementId = crypto.randomUUID();

const fsPath = (image as ImageMetadata & { fsPath?: string }).fsPath;
if (!fsPath) {
  throw new Error(`ImageView: cannot resolve fsPath for ${image.src}`);
}

const breakPoints = [
  400, 640, 800, 1024, 1280, 1440, 1920, 2560, 2880, 3840,
].filter((val) => val <= image.width);

const reader = new ExifTool();
const tags = await reader.read(fsPath);
await reader.end();

interface ExifData {
  camera?: string;
  lens?: string;
  aperture?: number;
  shutterSpeed?: string;
  iso?: number;
  focalLength?: string;
  height: number;
  width: number;
}

function extractData(tags: Tags): ExifData {
  let ret: ExifData = {
    camera: tags.Model,
    lens: tags.LensID,
    aperture: tags.Aperture,
    shutterSpeed: tags.ShutterSpeed?.toString(),
    iso: tags.ISO,
    focalLength: tags.FocalLength,
    height: image.height,
    width: image.width,
  };
  return ret;
}

const exifData = extractData(tags);
---

<style>
  .container {
    position: relative;
    overflow: hidden;
    color: #000;
  }

  .image {
    transition: filter 0.3s ease-in-out;
    pointer-events: none;
  }

  .subtitle {
    margin-bottom: 1rem;
  }

  .subtitle h3 {
    font-size: larger;
  }

  span.line {
    display: inline-block;
  }

  span.line-aperture::first-letter {
    font-family: "Trebuchet MS", "Lucida Sans Unicode", "Lucida Grande",
      "Lucida Sans", Arial, sans-serif;
    font-style: italic;
    font-weight: bold;
  }
</style>

<image-container data-elementid={elementId}>
  <div class="container" id={elementId}>
    <div class="image">
      <Picture
        src={image}
        alt={alt}
        formats={["jxl", "avif", "webp"]}
        fallbackFormat="jpg"
        widths={breakPoints}
        width={width ?? image.width}
        height={height ?? image.height}
        quality="high"
      />
    </div>
    <h3 class="subtitle text-slate-900 dark:text-slate-300">
      {alt}
    </h3>
    <span class="text-slate-900 dark:text-slate-400">
      {
        exifData.camera && (
          <span class="line">
            <strong>Camera:</strong> {exifData.camera}
          </span>
        )
      }
      {
        exifData.lens && (
          <span class="line">
            <strong>Lens:</strong> {exifData.lens}
          </span>
        )
      }
      {
        exifData.aperture && (
          <span class="line line-aperture">f/{exifData.aperture}</span>
        )
      }
      {
        typeof exifData.shutterSpeed === "string" && (
          <span class="line">
            <strong>Shutter Speed:</strong>{" "}
            <ShutterSpeed shutterSpeed={exifData.shutterSpeed} />
          </span>
        )
      }
      {
        exifData.iso && (
          <span class="line">
            <strong>ISO:</strong> {exifData.iso}
          </span>
        )
      }
      {
        exifData.focalLength && (
          <span class="line">
            <strong>Focal Length:</strong> {exifData.focalLength}
          </span>
        )
      }
      {
        exifData.height && exifData.width && (
          <span class="line">
            <strong>Resolution:</strong> {exifData.width}x{exifData.height}
          </span>
        )
      }
    </span>
  </div>
</image-container>

<script>
  class ImageContainer extends HTMLElement {
    constructor() {
      super();
      const container = document.getElementById(
        this.dataset.elementid!
      ) as HTMLDivElement;
      container.addEventListener("click", async (_) => {
        await container.requestFullscreen();
        container.addEventListener("keydown", (e) => {
          const event = e as KeyboardEvent;
          if (event.key === "Escape") {
            document.exitFullscreen();
          }
        });
      });
    }
  }
  customElements.define("image-container", ImageContainer);
</script>
