---
import "maplibre-gl/dist/maplibre-gl.css";
import { airports } from '@nwpr/airport-codes'
export interface Props {
  start: string;
  end: string;
}

const { start, end } = Astro.props;

const elementId = crypto.randomUUID();
const startAirport = airports.find(airport => airport.iata === start)!
const startAirportPosition = [
  startAirport.latitude,
  startAirport.longitude
];
const endAirport = airports.find(airport => airport.iata === end)!
const endAirportPosition = [
  endAirport.latitude,
  endAirport.longitude
];
---

<flight-map
  data-elementid={elementId}
  data-startlat={startAirportPosition[0]}
  data-startlng={startAirportPosition[1]}
  data-endlat={endAirportPosition[0]}
  data-endlng={endAirportPosition[1]}
>
  <div class="map-container">
    <div id={elementId}/>
  </div>
</flight-map>

<script>
  class FlightMap extends HTMLElement {
    async connectedCallback() {
      const container = this.dataset.elementid!;
      const coordinates: [[number, number], [number, number]] = [
        [parseFloat(this.dataset.startlng!), parseFloat(this.dataset.startlat!)],
        [parseFloat(this.dataset.endlng!), parseFloat(this.dataset.endlat!)],
      ];

      // maplibre-gl is ~1MB; load it only when a FlightMap actually mounts.
      const { Map, AttributionControl } = await import("maplibre-gl");

      const map = new Map({
        container,
        style: "https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json",
        center: [0, 0],
        zoom: 1,
        interactive: false,
        attributionControl: false,
      });

      map.addControl(new AttributionControl(), "bottom-right");

      map.on("load", () => {
        map.addSource("route-" + container, {
          type: "geojson",
          data: {
            type: "Feature",
            geometry: { type: "LineString", coordinates },
            properties: {},
          },
        });
        map.addLayer({
          id: "route-" + container,
          type: "line",
          source: "route-" + container,
          layout: {},
          paint: { "line-color": "purple", "line-width": 2 },
        });

        // Build a proper SW/NE bbox from the two endpoints. Just handing
        // MapLibre [start, end] gives a degenerate bbox whenever start isn't
        // already south-west of end (e.g. GMP -> CJU, where GMP is both north
        // and east of CJU), which silently falls back to the default view.
        const [a, b] = coordinates;
        const sw: [number, number] = [Math.min(a[0], b[0]), Math.min(a[1], b[1])];
        const ne: [number, number] = [Math.max(a[0], b[0]), Math.max(a[1], b[1])];
        map.fitBounds([sw, ne], { padding: 50, duration: 0 });
      });
    }
  }

  customElements.define("flight-map", FlightMap);
</script>

<style>
  div:not(.distance-container) {
    width: 100%;
    height: 400px;
  }

  .map-container {
    position: relative;
  }

  .distance-container {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
  }
  .distance-container > * {
    background-color: rgba(0, 0, 0, 0.5);
    color: #fff;
    font-size: 11px;
    line-height: 18px;
    display: block;
    margin: 0;
    padding: 5px;
    border-radius: 3px;
  }
</style>
