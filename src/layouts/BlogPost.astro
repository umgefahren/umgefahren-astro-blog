---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "@fontsource/jetbrains-mono";

interface Frontmatter {
  title: string;
  description: string;
  pubDate?: string | Date;
  updatedDate?: string;
}

export interface Props {
  frontmatter: Frontmatter;
}

const { frontmatter } = Astro.props;
const { title, description, pubDate } = frontmatter;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} />
    <style is:global>
      h2 {
        font-size: 1.5em;
        margin-top: 0.75em;
        margin-bottom: 0.25em;
      }

      .astro-code {
        font-family: "JetBrains Mono", monospace;
        margin-top: 0.5em;
        margin-bottom: 0;
      }
    </style>
  </head>

  <body class="bg-slate-200 dark:bg-slate-900">
    <main class="lg:max-w-screen-2xl md:max-w-screen-sm px-6 pt-8 mx-auto">
      <Header />
      <article>
        <h1 class="text-4xl text-gray-900 dark:text-gray-100 font-bold">
          {title}
        </h1>
        <p class="mt-1 text-gray-500"></p>
        {
          pubDate && (
            <time class="text-gray-900 dark:text-gray-100">
              {new Date(pubDate).toDateString()}
            </time>
          )
        }
        <p></p>
        <div
          class="text-gray-700 dark:text-gray-300 [&_code]:bg-slate-300 dark:[&_code]:bg-slate-800"
        >
          <slot />
        </div>
      </article>
    </main>
    <Footer />
  </body>
</html>
